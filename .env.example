# Postgres running in Docker (see docker-compose.yml)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/coffee

# API connection pool (optional; these are the defaults)
# DB_POOL_MIN_SIZE=1              # connections kept open while idle
# DB_POOL_MAX_SIZE=10             # most connections one API process may open
# DB_POOL_TIMEOUT_SECONDS=5       # longest a request waits for a free connection, then 503
# DB_STATEMENT_TIMEOUT_MS=5000    # longest a query may run, then 503
